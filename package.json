{
  "name": "pi-extension",
  "version": "0.2.0",
  "description": "Practical extensions for the Pi.dev coding agent",
  "keywords": [
    "pi-package",
    "pi-dev",
    "coding-agent"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "build:v4-supervisor": "esbuild extensions/lead-v4/supervisor-main.ts --bundle --platform=node --format=esm --target=node22 --outfile=extensions/lead-v4/runtime/supervisor.mjs --external:@earendil-works/* --external:typebox",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "./extensions/update.ts",
      "./extensions/lead/index.ts"
    ],
    "skills": [
      "./skills/lead-orchestration"
    ]
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.80.7",
    "@earendil-works/pi-tui": "0.80.7",
    "@types/node": "22.19.1",
    "esbuild": "^0.25.12",
    "tsx": "4.20.6",
    "typebox": "1.3.6",
    "typescript": "5.9.3"
  }
}
